      "id": "62cd47aa-5ccd-4d8d-b199-3b7c05e59fc8",
      "name": "Buscar Transferencias (Supabase)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        200,
        -80
      ],
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "aYsNFdB5mXwMqYVO",
          "name": "Supabase - app_financeiro"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r = $('Calcular Resumo').first().json;\nconst q = $('Webhook').first().json.query || {};\nconst ateFim = t => !q.periodo_fim || t.data <= q.periodo_fim;\nconst transf = $input.all().map(i => i.json).filter(x => x && x.id && ateFim(x));\n// Transferência não é receita nem despesa: só tira da origem e põe no destino (cada um na sua moeda)\nconst saldoPorConta = r.saldo_por_conta.map(c => {\n  const saiu = transf.filter(t => t.conta_origem_id === c.conta_id).reduce((s, t) => s + Number(t.valor_origem), 0);\n  const entrou = transf.filter(t => t.conta_destino_id === c.conta_id).reduce((s, t) => s + Number(t.valor_destino), 0);\n  return { ...c, saldo: c.saldo - saiu + entrou };\n});\nreturn [{ json: { ...r, saldo_por_conta: saldoPorConta } }];"
      },
      "id": "6a6d50d4-d0b4-4e5b-b032-ccd0d5b1682c",
      "name": "Aplicar Transferencias",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        -80
      ]
    }
