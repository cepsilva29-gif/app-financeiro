      "id": "c01d3d2c-ccd6-4f88-8471-5bc2a18ceac3",
      "name": "Tem Moeda Estrangeira?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        600,
        -80
      ]
    },
    {
      "parameters": {
        "url": "={{ \"https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata/CotacaoDolarPeriodo(dataInicial=@dataInicial,dataFinalCotacao=@dataFinalCotacao)?@dataInicial='\" + $now.setZone('America/Sao_Paulo').minus({ days: 10 }).toFormat('MM-dd-yyyy') + \"'&@dataFinalCotacao='\" + $now.setZone('America/Sao_Paulo').toFormat('MM-dd-yyyy') + \"'&$format=json\" }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "366878f0-9676-40d5-8ecf-f88d63c2e33c",
      "name": "Buscar PTAX Atual",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        -160
      ],
      "continueOnFail": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $('Aplicar Transferencias').first().json;\nconst q = $('Webhook').first().json.query || {};\nconst contas = $('Buscar Contas (Supabase)').all().map(i => i.json).filter(x => x && x.id);\nconst transacoes = $('Buscar Transacoes (Supabase)').all().map(i => i.json).filter(x => x && x.id);\nconst moedaDaConta = Object.fromEntries(contas.map(c => [c.id, c.moeda || 'BRL']));\nconst temEstrangeira = contas.some(c => (c.moeda || 'BRL') !== 'BRL');\n// Cotação atual: último boletim PTAX (só buscado quando existe conta não-BRL)\nlet cotacaoAtual = null;\nif (temEstrangeira) {\n  const boletins = Array.isArray(($input.first().json || {}).value) ? $input.first().json.value : [];\n  const ultimo = boletins[boletins.length - 1];\n  if (ultimo) cotacaoAtual = { valor: Number(ultimo.cotacaoVenda), data: String(ultimo.dataHoraCotacao).slice(0, 10) };\n}\nconst emPeriodo = t => (!q.periodo_inicio || t.data >= q.periodo_inicio) && (!q.periodo_fim || t.data <= q.periodo_fim);\n// Lançamento: converte pela cotação da própria data; sem cotação (pendente) → cotação atual\nlet semCotacao = 0, naoConvertidos = 0;\nconst emReais = t => {\n  const m = moedaDaConta[t.conta_id] || 'BRL';\n  if (m === 'BRL') return Number(t.valor);\n  if (t.cotacao !== null && t.cotacao !== undefined) return Number(t.valor) * Number(t.cotacao);\n  if (cotacaoAtual) { semCotacao++; return Number(t.valor) * cotacaoAtual.valor; }\n  naoConvertidos++; return 0;\n};\nconst totais = { receitas: 0, despesas: 0, saldo: 0 };\nconst porCat = {};\nfor (const t of transacoes.filter(emPeriodo)) {\n  const v = emReais(t);\n  totais[t.tipo === 'receita' ? 'receitas' : 'despesas'] += v;\n  const key = t.categoria_id === null || t.categoria_id === undefined ? 'sem_categoria' : t.categoria_id;\n  if (!porCat[key]) porCat[key] = { categoria_id: t.categoria_id, receita: 0, despesa: 0 };\n  porCat[key][t.tipo] += v;\n}\ntotais.saldo = totais.receitas - totais.despesas;\n// Saldo de conta estrangeira = quanto vale hoje → cotação atual\nconst saldoPorConta = r.saldo_por_conta.map(c => {\n  if (c.moeda === 'BRL') return { ...c, saldo_original: c.saldo };\n  if (!cotacaoAtual) { naoConvertidos++; return { ...c, saldo_original: c.saldo, saldo: 0 }; }\n  return { ...c, saldo_original: c.saldo, saldo: c.saldo * cotacaoAtual.valor };\n});\nreturn [{ json: { ...r, consolidado: {\n  moeda: 'BRL',\n  disponivel: naoConvertidos === 0,\n  cotacao_atual: cotacaoAtual,\n  lancamentos_pela_cotacao_atual: semCotacao,\n  totais,\n  por_categoria: Object.values(porCat),\n  saldo_por_conta: saldoPorConta\n} } }];"
      },
      "id": "3f1e9d87-0b7a-471c-93e9-7c7eaf1884a5",
      "name": "Consolidar em BRL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        -80
      ]
    },
    {
      "parameters": {
