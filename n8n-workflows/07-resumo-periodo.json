    {
      "parameters": {
        "jsCode": "const q = $('Webhook').first().json.query || {};\nconst contas = $('Buscar Contas (Supabase)').all().map(i => i.json).filter(r => r && r.id);\nconst transacoes = $input.all().map(i => i.json).filter(r => r && r.id);\nconst emPeriodo = t => (!q.periodo_inicio || t.data >= q.periodo_inicio) && (!q.periodo_fim || t.data <= q.periodo_fim);\nconst ateFim = t => !q.periodo_fim || t.data <= q.periodo_fim;\nconst saldoPorConta = contas.map(c => {\n  const doConta = transacoes.filter(t => t.conta_id === c.id && ateFim(t));\n  const receitas = doConta.filter(t => t.tipo === 'receita').reduce((s, t) => s + Number(t.valor), 0);\n  const despesas = doConta.filter(t => t.tipo === 'despesa').reduce((s, t) => s + Number(t.valor), 0);\n  return { conta_id: c.id, nome: c.nome, saldo: Number(c.saldo_inicial) + receitas - despesas };\n});\nconst noPeriodo = transacoes.filter(emPeriodo);\nconst totalReceitas = noPeriodo.filter(t => t.tipo === 'receita').reduce((s, t) => s + Number(t.valor), 0);\nconst totalDespesas = noPeriodo.filter(t => t.tipo === 'despesa').reduce((s, t) => s + Number(t.valor), 0);\nconst porCategoriaMap = {};\nfor (const t of noPeriodo) {\n  const key = t.categoria_id === null || t.categoria_id === undefined ? 'sem_categoria' : t.categoria_id;\n  if (!porCategoriaMap[key]) porCategoriaMap[key] = { categoria_id: t.categoria_id, receita: 0, despesa: 0 };\n  porCategoriaMap[key][t.tipo] += Number(t.valor);\n}\nreturn [{ json: {\n  sucesso: true,\n  periodo: { inicio: q.periodo_inicio || null, fim: q.periodo_fim || null },\n  saldo_por_conta: saldoPorConta,\n  totais: { receitas: totalReceitas, despesas: totalDespesas, saldo: totalReceitas - totalDespesas },\n  por_categoria: Object.values(porCategoriaMap)\n} }];"
      },
