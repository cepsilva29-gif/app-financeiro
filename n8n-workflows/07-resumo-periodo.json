    {
      "parameters": {
        "jsCode": "const q = $('Webhook').first().json.query || {};\nconst contas = $('Buscar Contas (Supabase)').all().map(i => i.json).filter(r => r && r.id);\nconst transacoes = $input.all().map(i => i.json).filter(r => r && r.id);\nconst moedaDaConta = Object.fromEntries(contas.map(c => [c.id, c.moeda || 'BRL']));\nconst moedaDe = t => moedaDaConta[t.conta_id] || 'BRL';\nconst emPeriodo = t => (!q.periodo_inicio || t.data >= q.periodo_inicio) && (!q.periodo_fim || t.data <= q.periodo_fim);\nconst ateFim = t => !q.periodo_fim || t.data <= q.periodo_fim;\nconst saldoPorConta = contas.map(c => {\n  const doConta = transacoes.filter(t => t.conta_id === c.id && ateFim(t));\n  const receitas = doConta.filter(t => t.tipo === 'receita').reduce((s, t) => s + Number(t.valor), 0);\n  const despesas = doConta.filter(t => t.tipo === 'despesa').reduce((s, t) => s + Number(t.valor), 0);\n  return { conta_id: c.id, nome: c.nome, moeda: c.moeda || 'BRL', saldo: Number(c.saldo_inicial) + receitas - despesas };\n});\nconst noPeriodo = transacoes.filter(emPeriodo);\n// Nunca soma moedas diferentes: um bloco de totais por moeda\nconst totaisPorMoeda = {};\nfor (const t of noPeriodo) {\n  const m = moedaDe(t);\n  if (!totaisPorMoeda[m]) totaisPorMoeda[m] = { receitas: 0, despesas: 0, saldo: 0, lancamentos: 0 };\n  totaisPorMoeda[m][t.tipo === 'receita' ? 'receitas' : 'despesas'] += Number(t.valor);\n  totaisPorMoeda[m].lancamentos += 1;\n}\nfor (const m of Object.keys(totaisPorMoeda)) totaisPorMoeda[m].saldo = totaisPorMoeda[m].receitas - totaisPorMoeda[m].despesas;\nconst porCategoriaMap = {};\nfor (const t of noPeriodo) {\n  const m = moedaDe(t);\n  const key = (t.categoria_id === null || t.categoria_id === undefined ? 'sem_categoria' : t.categoria_id) + '|' + m;\n  if (!porCategoriaMap[key]) porCategoriaMap[key] = { categoria_id: t.categoria_id, moeda: m, receita: 0, despesa: 0 };\n  porCategoriaMap[key][t.tipo] += Number(t.valor);\n}\n// totais (legado) = só BRL, pra um frontend antigo nunca somar dólar com real\nconst brl = totaisPorMoeda.BRL || { receitas: 0, despesas: 0, saldo: 0 };\nreturn [{ json: {\n  sucesso: true,\n  periodo: { inicio: q.periodo_inicio || null, fim: q.periodo_fim || null },\n  saldo_por_conta: saldoPorConta,\n  totais_por_moeda: totaisPorMoeda,\n  totais: { receitas: brl.receitas, despesas: brl.despesas, saldo: brl.saldo },\n  por_categoria: Object.values(porCategoriaMap)\n} }];"
      },
