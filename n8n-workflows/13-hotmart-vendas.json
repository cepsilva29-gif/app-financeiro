              "leftValue": "={{ ['PURCHASE_CANCELED','PURCHASE_REFUNDED','PURCHASE_CHARGEBACK'].includes($('Extrair Evento').first().json.evento) && !!$('Resolver Empresa').first().json.empresa_id }}",
