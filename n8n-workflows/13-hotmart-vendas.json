      },
      "id": "a1b2c3d4-0001-4a11-9001-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1800, 0],
      "webhookId": "b2c3d4e5-0002-4a22-9002-000000000002",
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_CREDENTIAL_ID",
          "name": "Hotmart - app_financeiro"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst EVENTOS_VALIDOS = {\n  'PURCHASE_APPROVED': 'aprovada',\n  'PURCHASE_CANCELED': 'cancelada',\n  'PURCHASE_REFUNDED': 'reembolsada',\n  'PURCHASE_CHARGEBACK': 'chargeback',\n};\nconst evento = String(body.event || '').trim();\nconst data = body.data || {};\nconst buyer = data.buyer || {};\nconst purchase = data.purchase || {};\nconst product = data.product || {};\nreturn [{ json: {\n  reconhecido: Object.prototype.hasOwnProperty.call(EVENTOS_VALIDOS, evento),\n  evento,\n  status: EVENTOS_VALIDOS[evento] || null,\n  transacao_hotmart: String(purchase.transaction || ''),\n  produto: product.name || null,\n  comprador_nome: buyer.name || null,\n  comprador_email: buyer.email ? String(buyer.email).trim().toLowerCase() : null,\n  valor: (purchase.price && purchase.price.value != null) ? Number(purchase.price.value) : null,\n  payload: body,\n} }];"
      },
      "id": "a1b2c3d4-0003-4a33-9003-000000000003",
      "name": "Extrair Evento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1600, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 1 },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.reconhecido }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-4a44-9004-000000000004",
      "name": "Evento Reconhecido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-1400, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"sucesso\": true, \"ignorado\": true } }}",
        "options": { "responseCode": 200 }
      },
      "id": "a1b2c3d4-0005-4a55-9005-000000000005",
      "name": "Responder Ignorado",
      "type": "n8n-nodes-base.respondToWebhook",
