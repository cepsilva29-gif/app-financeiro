      "position": [-1200, -80],
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": { "id": "aYsNFdB5mXwMqYVO", "name": "Supabase - app_financeiro" }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.id);\nreturn [{ json: { duplicado: rows.length > 0 } }];"
      },
