      "id": "77a3c100-3d88-4130-8f79-f76056219e10",
      "name": "Buscar Transacoes (Supabase)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -200,
        -50
      ],
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "aYsNFdB5mXwMqYVO",
          "name": "Supabase - app_financeiro"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const q = $('Webhook').first().json.query || {};\nlet rows = $input.all().map(i => i.json).filter(r => r && r.id);\nif (q.conta_id) rows = rows.filter(r => String(r.conta_id) === String(q.conta_id));\nif (q.categoria_id) rows = rows.filter(r => String(r.categoria_id) === String(q.categoria_id));\nif (q.tipo) rows = rows.filter(r => r.tipo === q.tipo);\nif (q.periodo_inicio) rows = rows.filter(r => r.data >= q.periodo_inicio);\nif (q.periodo_fim) rows = rows.filter(r => r.data <= q.periodo_fim);\nrows.sort((a, b) => (a.data < b.data ? 1 : a.data > b.data ? -1 : 0));\nreturn [{ json: { sucesso: true, total: rows.length, transacoes: rows } }];"
      },
      "id": "c4727505-7689-400a-b6c2-25c472b4cb5f",
      "name": "Filtrar E Responder",
      "type": "n8n-nodes-base.code",
