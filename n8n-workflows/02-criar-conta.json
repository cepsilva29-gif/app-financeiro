    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst erros = [];\nconst nome = String(body.nome || '').trim();\nconst tipo = body.tipo;\nconst saldoInicial = body.saldo_inicial === undefined ? 0 : Number(body.saldo_inicial);\nif (!nome) erros.push('nome');\nif (!['caixa','banco','cartao'].includes(tipo)) erros.push('tipo');\nif (Number.isNaN(saldoInicial)) erros.push('saldo_inicial');\nif (erros.length) return [{ json: { valido: false, erro: 'Campos invalidos ou ausentes: ' + erros.join(', ') } }];\nreturn [{ json: { valido: true, empresa_id: $('Checar Empresa').first().json.empresa_id, nome, tipo, saldo_inicial: saldoInicial } }];"
      },
