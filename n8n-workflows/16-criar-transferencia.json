    {
      "parameters": {
        "jsCode": "const v = $('Validar Dados').first().json;\nconst contas = $input.all().map(i => i.json).filter(r => r && r.id);\nconst origem = contas.find(c => c.id === v.conta_origem_id);\nconst destino = contas.find(c => c.id === v.conta_destino_id);\nif (!origem || !destino) return [{ json: { valido: false, erro: 'Conta de origem ou destino nao existe ou nao pertence a esta empresa.' } }];\nconst moedaOrigem = origem.moeda || 'BRL';\nconst moedaDestino = destino.moeda || 'BRL';\nlet valorDestino = v.valor_destino;\nif (moedaOrigem === moedaDestino) valorDestino = v.valor_origem; // mesma moeda: entra exatamente o que sai\nelse if (valorDestino === null) return [{ json: { valido: false, erro: 'Contas em moedas diferentes (' + moedaOrigem + ' para ' + moedaDestino + '): informe valor_destino (quanto entrou na conta de destino).' } }];\nreturn [{ json: { valido: true, valor_destino: valorDestino } }];"
      },
