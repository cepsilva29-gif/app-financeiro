    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst erros = [];\nconst origem = Number(body.conta_origem_id);\nconst destino = Number(body.conta_destino_id);\nconst valorOrigem = Number(body.valor_origem);\nconst valorDestino = body.valor_destino === undefined || body.valor_destino === null || body.valor_destino === '' ? null : Number(body.valor_destino);\nconst data = body.data;\nif (!Number.isFinite(origem)) erros.push('conta_origem_id');\nif (!Number.isFinite(destino)) erros.push('conta_destino_id');\nif (!Number.isFinite(valorOrigem) || valorOrigem <= 0) erros.push('valor_origem');\nif (valorDestino !== null && !(Number.isFinite(valorDestino) && valorDestino > 0)) erros.push('valor_destino');\nif (!data || !/^\\d{4}-\\d{2}-\\d{2}$/.test(data)) erros.push('data');\nif (erros.length) return [{ json: { valido: false, erro: 'Campos invalidos ou ausentes: ' + erros.join(', ') } }];\nif (origem === destino) return [{ json: { valido: false, erro: 'A conta de origem e a de destino precisam ser diferentes.' } }];\nreturn [{ json: { valido: true, empresa_id: $('Checar Empresa').first().json.empresa_id, conta_origem_id: origem, conta_destino_id: destino, valor_origem: valorOrigem, valor_destino: valorDestino, data, descricao: body.descricao || null } }];"
      },
