    {
      "parameters": {
        "jsCode": "const e = $('Checar Empresa').first().json;\nconst filiais = $('Buscar Filiais').all().map(i => i.json).filter(r => r && r.id).map(f => ({ id: f.id, slug: f.slug, nome: f.nome }));\nreturn [{ json: { id: e.empresa_id, slug: e.slug, nome: e.nome, timezone: e.timezone, moeda: e.moeda, filiais } }];"
      },
