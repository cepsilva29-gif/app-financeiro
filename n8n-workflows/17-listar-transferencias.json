    },
    {
      "parameters": {
        "jsCode": "const q = $('Webhook').first().json.query || {};\nlet rows = $input.all().map(i => i.json).filter(r => r && r.id);\nif (q.periodo_inicio) rows = rows.filter(t => t.data >= q.periodo_inicio);\nif (q.periodo_fim) rows = rows.filter(t => t.data <= q.periodo_fim);\nif (q.conta_id) rows = rows.filter(t => t.conta_origem_id === Number(q.conta_id) || t.conta_destino_id === Number(q.conta_id));\nrows.sort((a, b) => (a.data < b.data ? 1 : a.data > b.data ? -1 : b.id - a.id));\nreturn [{ json: { sucesso: true, transferencias: rows } }];"
      },
