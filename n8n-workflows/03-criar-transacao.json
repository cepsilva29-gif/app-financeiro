    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst erros = [];\nconst contaId = Number(body.conta_id);\nconst categoriaId = body.categoria_id === undefined || body.categoria_id === null || body.categoria_id === '' ? null : Number(body.categoria_id);\nconst tipo = body.tipo;\nconst valor = Number(body.valor);\nconst data = body.data;\nconst status = body.status || 'confirmado';\nconst origem = body.origem || 'manual';\nif (!Number.isFinite(contaId)) erros.push('conta_id');\nif (categoriaId !== null && !Number.isFinite(categoriaId)) erros.push('categoria_id');\nif (!['receita','despesa'].includes(tipo)) erros.push('tipo');\nif (!Number.isFinite(valor) || valor <= 0) erros.push('valor');\nif (!data || !/^\\d{4}-\\d{2}-\\d{2}$/.test(data)) erros.push('data');\nif (!['previsto','confirmado'].includes(status)) erros.push('status');\nif (!['manual','importado'].includes(origem)) erros.push('origem');\nif (erros.length) return [{ json: { valido: false, erro: 'Campos invalidos ou ausentes: ' + erros.join(', ') } }];\nreturn [{ json: { valido: true, empresa_id: $('Checar Empresa').first().json.empresa_id, conta_id: contaId, categoria_id: categoriaId, tipo, valor, descricao: body.descricao || null, data, status, origem } }];"
      },
