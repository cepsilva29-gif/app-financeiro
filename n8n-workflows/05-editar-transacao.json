    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst existing = $('Checar Transacao').first().json.transacao;\nconst erros = [];\nconst out = { empresa_id: existing.empresa_id, id: existing.id };\nconst contaAlterada = body.conta_id !== undefined;\nout.conta_id = contaAlterada ? Number(body.conta_id) : existing.conta_id;\nif (contaAlterada && !Number.isFinite(out.conta_id)) erros.push('conta_id');\nconst categoriaAlterada = body.categoria_id !== undefined;\nout.categoria_id = categoriaAlterada ? (body.categoria_id === null ? null : Number(body.categoria_id)) : existing.categoria_id;\nif (categoriaAlterada && out.categoria_id !== null && !Number.isFinite(out.categoria_id)) erros.push('categoria_id');\nout.tipo = body.tipo !== undefined ? body.tipo : existing.tipo;\nif (!['receita','despesa'].includes(out.tipo)) erros.push('tipo');\nout.valor = body.valor !== undefined ? Number(body.valor) : Number(existing.valor);\nif (!Number.isFinite(out.valor) || out.valor <= 0) erros.push('valor');\nout.descricao = body.descricao !== undefined ? body.descricao : existing.descricao;\nout.data = body.data !== undefined ? body.data : existing.data;\nif (!out.data || !/^\\d{4}-\\d{2}-\\d{2}$/.test(out.data)) erros.push('data');\nout.status = body.status !== undefined ? body.status : existing.status;\nif (!['previsto','confirmado'].includes(out.status)) erros.push('status');\nout.origem = body.origem !== undefined ? body.origem : existing.origem;\nif (!['manual','importado'].includes(out.origem)) erros.push('origem');\nif (erros.length) return [{ json: { valido: false, erro: 'Campos invalidos: ' + erros.join(', ') } }];\nreturn [{ json: { valido: true, contaAlterada, categoriaAlterada, ...out } }];"
      },
