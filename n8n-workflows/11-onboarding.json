        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"from\": \"app_financeiro <financeiro@engenhariadedadosn8n.shop>\", \"to\": [$json.empresa.email], \"subject\": \"Bem-vindo(a) ao app_financeiro, \" + $json.empresa.nome + \"!\", \"html\": \"<p>Ol\\u00e1! O painel financeiro da <strong>\" + $json.empresa.nome + \"</strong> j\\u00e1 est\\u00e1 pronto.</p>\" + \"<p><a href='https://financeiro.engenhariadedadosn8n.shop/?token=\" + $json.empresa.access_token + \"'>Clique aqui para acessar</a> \\u2014 o acesso fica salvo no seu navegador, n\\u00e3o precisa digitar o c\\u00f3digo de novo depois.</p>\" + \"<p>Se o link n\\u00e3o funcionar, acesse <a href='https://financeiro.engenhariadedadosn8n.shop'>https://financeiro.engenhariadedadosn8n.shop</a> e informe este c\\u00f3digo de acesso:</p>\" + \"<p><code>\" + $json.empresa.access_token + \"</code></p>\" } }}",
