    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst erros = [];\nconst slug = String(body.slug || '').trim().toLowerCase();\nif (!slug || !/^[a-z0-9-]+$/.test(slug)) erros.push('slug');\nconst nome = String(body.nome || '').trim();\nif (!nome) erros.push('nome');\nconst email = String(body.email || '').trim().toLowerCase();\nif (!email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) erros.push('email');\nconst moeda = body.moeda || 'BRL';\nconst timezone = body.timezone || 'America/Sao_Paulo';\nconst categoriasDefault = [\n  { nome: 'Vendas', tipo: 'receita' },\n  { nome: 'Servicos', tipo: 'receita' },\n  { nome: 'Fornecedores', tipo: 'despesa' },\n];\nlet categorias = Array.isArray(body.categorias) && body.categorias.length ? body.categorias : categoriasDefault;\ncategorias = categorias.filter(c => c && c.nome && ['receita','despesa'].includes(c.tipo));\nif (categorias.length === 0) erros.push('categorias');\nconst contaInicial = body.conta_inicial || {};\nconst conta = {\n  nome: contaInicial.nome || 'Caixa',\n  tipo: ['caixa','banco','cartao'].includes(contaInicial.tipo) ? contaInicial.tipo : 'caixa',\n  saldo_inicial: Number.isFinite(Number(contaInicial.saldo_inicial)) ? Number(contaInicial.saldo_inicial) : 0,\n};\nfunction gerarToken() {\n  try {\n    const { randomBytes } = require('crypto');\n    return 'fin_' + randomBytes(16).toString('hex');\n  } catch (e) {\n    let s = '';\n    for (let i = 0; i < 32; i++) s += Math.floor(Math.random() * 16).toString(16);\n    return 'fin_' + s;\n  }\n}\nif (erros.length) return [{ json: { valido: false, erro: 'Campos invalidos ou ausentes: ' + erros.join(', ') } }];\nreturn [{ json: { valido: true, slug, nome, email, moeda, timezone, categorias, conta_inicial: conta, access_token: gerarToken() } }];"
      },
