      "parameters": {
        "jsCode": "const empresa = $('Criar Empresa (Supabase)').first().json;\nconst conta = $json;\nconst categorias = $('Validar Dados').first().json.categorias;\nreturn [{ json: {\n  sucesso: true,\n  empresa: { id: empresa.id, slug: empresa.slug, nome: empresa.nome, email: empresa.email, moeda: empresa.moeda, timezone: empresa.timezone, access_token: empresa.access_token },\n  conta_inicial: conta,\n  categorias_criadas: categorias.length\n} }];"
      },
