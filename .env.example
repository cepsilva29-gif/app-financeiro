# Projeto Supabase próprio do app_financeiro (schema em supabase/schema.sql).
# service_role NUNCA vai aqui — fica só como credencial dentro do n8n.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Domínio onde o frontend é servido — subdomínio por empresa: app.<slug>.DOMAIN
DOMAIN=

# Header X-Admin-Token exigido por POST /webhook/financeiro/onboarding (cria empresa nova).
# Não é o access_token de nenhuma empresa — é uma credencial só do operador. Gerar com
# 'adm_' + 24 bytes aleatórios em hex.
ONBOARDING_ADMIN_TOKEN=
